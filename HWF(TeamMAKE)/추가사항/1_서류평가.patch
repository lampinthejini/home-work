+    """이미 서류 평가를 받은 지원자가 있으면 기준을 바꾸지 않는다 (지원자마다 다른 기준이 되지 않게, CONFLICTS C-24)."""
+    return (db.query(ResumeScreening.id).join(Application, Application.id == ResumeScreening.application_id)
+            .filter(Application.posting_id == posting.id).first() is not None)
+
+
+def cleanSkills(skills: list[str]) -> list[str]:
+    """빈 칸·중복(대소문자 무시)을 빼고 앞뒤 공백을 지운다. 한 개는 50자까지."""
+    seen, out = set(), []
+    for skill in skills:
+        name = skill.strip()[:50]
+        if name and name.lower() not in seen:
+            seen.add(name.lower())
+            out.append(name)
+    return out
+
+
+def applyScreening(c: EvaluationCriteria, body) -> None:
+    """서류 평가 설정 (CONFLICTS C-24). 켜면 필수 기술이 1개 이상이어야 한다 (기술스택 항목의 기준이 된다)."""
+    required = cleanSkills(body.screening_required_skills)
+    if body.screening_enabled and not required:
+        raise ApiError(400, "SCREENING_SKILLS", "서류 평가를 켜려면 필수 기술을 1개 이상 넣어 주세요.")
+    c.screening_enabled = body.screening_enabled
+    c.screening_required_skills = required
+    c.screening_preferred_skills = [s for s in cleanSkills(body.screening_preferred_skills) if s.lower() not in {r.lower() for r in required}]
+    c.screening_pass_score = body.screening_pass_score
+    c.screening_band = body.screening_band
+
