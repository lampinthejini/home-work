# 비밀값 — 저장소에 올리지 않는다 (.gitignore)
POSTGRES_PASSWORD=
# 필수. 영문·숫자만 (주소에 그대로 들어간다). 만들기: openssl rand -hex 32
REDIS_PASSWORD=
S3_ACCESS_KEY=huge-store
S3_SECRET_KEY=
# 필수. 없으면 앱이 켜지지 않는다. 만들기: openssl rand -base64 32 (잃어버리면 데이터를 복구할 수 없으니 따로 보관)
APP_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@huge.local
ADMIN_INITIAL_PASSWORD=
# 로그인 차단에서 뺄 IP (쉼표로 구분, CIDR 가능). 비워 두면 이 PC 에서의 접속만 뺀다. 외부에 공개하면 내 IP 를 적는다
# LOGIN_EXEMPT_IPS=
# 결정 LLM(CPU) 이미지. 비우면 compose.ai.yml 의 고정 digest 를 쓴다
LLAMACPP_CPU_TAG=server@sha256:b32890309c1a33a534a01b0b461e953dc2c5a6bac20213abcf48e22847a19c85
LLAMACPP_TAG=server-cuda@sha256:0283744a35a6e7698b4f7a2d63360233dc769ece51e84bdba7aa187a33978276
APP_PROFILE=dev
